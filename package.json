{
  "name": "mcp-reference-implementation",
  "version": "2.0.0",
  "description": "Reference implementation of MCP Server, Client, and Agent using the official TypeScript SDK (MCP 2025-06-18)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "server": "node dist/server/index.js",
    "server:http": "node dist/server/http-server.js",
    "client": "node dist/client/index.js",
    "agent": "node dist/agent/simple-agent.js",
    "agent:intelligent": "node dist/agent/intelligent-agent.js",
    "test": "vitest",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:http": "vitest run tests/http-transport.test.ts",
    "dev:server": "tsx src/server/index.ts",
    "dev:server:http": "tsx src/server/http-server.ts",
    "dev:client": "tsx src/client/index.ts",
    "dev:agent": "tsx src/agent/simple-agent.ts",
    "dev:agent:intelligent": "tsx src/agent/intelligent-agent.ts",
    "example:interactive": "tsx src/examples/interactive-agent.ts",
    "example:oauth:auth-server": "tsx examples/oauth-roles/01-authorization-server.ts",
    "example:oauth:resource-server": "tsx examples/oauth-roles/02-resource-server.ts",
    "example:oauth:client": "tsx examples/oauth-roles/03-oauth-client.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/server/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai",
    "reference-implementation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.1.2",
    "jsonwebtoken": "^9.0.2",
    "oauth4webapi": "^3.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
