{
  "name": "mcp-reference-implementation",
  "version": "2.0.0",
  "description": "Reference implementation of MCP Server, Client, and Agent using the official TypeScript SDK (MCP 2025-06-18)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "server": "node dist/server/index.js",
    "server:http": "node dist/server/http-server.js",
    "client": "node dist/client/index.js",
    "agent": "node dist/agent/simple-agent.js",
    "agent:intelligent": "node dist/agent/intelligent-agent.js",
    "agent:oauth": "node dist/agent/oauth-intelligent-agent.js",
    "mcp:playwright": "node dist/mcp-servers/playwright-server.js",
    "mcp:github": "node dist/mcp-servers/github-server.js",
    "web-chat": "node dist/web-chat/server.js",
    "health-chat": "node dist/health-chat/server.js",
    "dev:health-chat": "tsx src/health-chat/server.ts",
    "agent:healthcare": "node dist/agent/healthcare-intelligent-agent.js",
    "dev:agent:healthcare": "tsx src/agent/healthcare-intelligent-agent.ts",
    "mcp:healthcare:patient": "node dist/mcp-servers/healthcare/patient-records-server.js",
    "mcp:healthcare:pharmacy": "node dist/mcp-servers/healthcare/pharmacy-server.js",
    "mcp:healthcare:clinical": "node dist/mcp-servers/healthcare/clinical-workflow-server.js",
    "dev:agent:oauth": "tsx src/agent/oauth-intelligent-agent.ts",
    "dev:mcp:playwright": "tsx src/mcp-servers/playwright-server.ts",
    "dev:mcp:github": "tsx src/mcp-servers/github-server.ts",
    "dev:web-chat": "tsx src/web-chat/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:unit:tools": "vitest run tests/unit/tools",
    "test:unit:auth": "vitest run tests/unit/auth",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:http": "vitest run tests/http-transport.test.ts",
    "test:agent": "vitest run tests/agent",
    "test:agent:simple": "vitest run tests/agent/simple-agent.test.ts",
    "test:agent:intelligent": "vitest run tests/agent/intelligent-agent.test.ts",
    "test:agent:intelligent:live": "LIVE_LLM=true vitest run tests/agent/intelligent-agent.test.ts",
    "test:mcp-compliance": "vitest run tests/mcp-compliance",
    "test:ci": "vitest run tests/unit tests/integration.test.ts tests/mcp-compliance",
    "test:ci:full": "vitest run tests/unit tests/integration.test.ts tests/mcp-compliance tests/agent/simple-agent.test.ts",
    "test:nightly": "LIVE_LLM=true vitest run",
    "test:flake-detection": "vitest run --reporter=verbose --retry=3 tests/agent",
    "dev:server": "tsx src/server/index.ts",
    "dev:server:http": "tsx src/server/http-server.ts",
    "dev:client": "tsx src/client/index.ts",
    "dev:agent": "tsx src/agent/simple-agent.ts",
    "dev:agent:intelligent": "tsx src/agent/intelligent-agent.ts",
    "example:interactive": "tsx src/examples/interactive-agent.ts",
    "example:oauth:auth-server": "tsx examples/oauth-roles/01-authorization-server.ts",
    "example:oauth:resource-server": "tsx examples/oauth-roles/02-resource-server.ts",
    "example:oauth:client": "tsx examples/oauth-roles/03-oauth-client.ts",
    "example:oauth:test-flow": "tsx examples/oauth-roles/test-complete-flow.ts",
    "example:oauth:test-interactive": "tsx examples/oauth-roles/test-interactive-flow.ts",
    "example:oauth:test-revocation": "tsx examples/oauth-roles/test-token-revocation.ts",
    "example:oauth:interactive": "tsx examples/oauth-roles/04-interactive-demo.ts",
    "example:oauth:edge-cases": "tsx examples/oauth-roles/test-edge-cases.ts",
    "example:enterprise:sso": "tsx examples/oauth-enterprise/test-sso-flow.ts",
    "example:enterprise:real-auth0": "tsx examples/oauth-enterprise/test-real-auth0.ts",
    "example:enterprise:scopes": "tsx examples/oauth-enterprise/test-scope-filtering.ts",
    "test:oauth:all": "tsx scripts/run-all-oauth-tests.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/server/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai",
    "reference-implementation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@octokit/rest": "^22.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.1.2",
    "jsonwebtoken": "^9.0.2",
    "oauth4webapi": "^3.8.2",
    "open": "^11.0.0",
    "openid-client": "^6.8.1",
    "playwright": "^1.56.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
